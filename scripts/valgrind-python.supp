# Valgrind suppression file for Python and ALE
# This file suppresses known false positives from Python's memory management
# Usage: valgrind --suppressions=.valgrind-python.supp <command>

# Python's PyMalloc arena allocator intentionally pools memory
{
   python_pymalloc
   Memcheck:Leak
   match-leak-kinds: possible,reachable
   ...
   fun:_PyObject_Malloc
}

{
   python_arena
   Memcheck:Leak
   match-leak-kinds: possible,reachable
   ...
   fun:_PyArena_*
}

{
   python_dict
   Memcheck:Leak
   match-leak-kinds: possible,reachable
   ...
   fun:PyDict_*
}

{
   python_list
   Memcheck:Leak
   match-leak-kinds: possible,reachable
   ...
   fun:PyList_*
}

{
   python_tuple
   Memcheck:Leak
   match-leak-kinds: possible,reachable
   ...
   fun:PyTuple_*
}

{
   python_unicode
   Memcheck:Leak
   match-leak-kinds: possible,reachable
   ...
   fun:PyUnicode_*
}

{
   python_type
   Memcheck:Leak
   match-leak-kinds: possible,reachable
   ...
   fun:PyType_*
}

{
   python_import
   Memcheck:Leak
   match-leak-kinds: possible,reachable
   ...
   fun:PyImport_*
}

# NumPy can have similar pooling behavior
{
   numpy_array
   Memcheck:Leak
   match-leak-kinds: possible,reachable
   ...
   obj:*/numpy/*.so
}

# SDL library (if enabled)
{
   sdl_init
   Memcheck:Leak
   match-leak-kinds: possible,reachable
   ...
   fun:SDL_*
}

# Helgrind suppressions for known thread-safe patterns

# Python GIL is thread-safe by design
{
   python_gil
   Helgrind:Race
   ...
   fun:PyGILState_*
}

{
   python_threadstate
   Helgrind:Race
   ...
   fun:PyThreadState_*
}

# C++ standard library threading
{
   libstdc++_thread
   Helgrind:Race
   ...
   obj:*/libstdc++.so*
}

{
   libstdc++_once
   Helgrind:Race
   fun:__once_proxy
}

# ALE vector environment uses moodycamel::LightweightSemaphore for the
# worker -> main thread Timestep hand-off in StateBuffer. The semaphore
# combines a std::atomic spin counter with a kernel semaphore on the slow
# path — helgrind tracks pthread sem_post/sem_wait but cannot follow the
# atomic-only fast path, so it misses the happens-before edge and reports
# bytes of the observation buffer as racy. Synchronization is sound (seq_cst
# fetch_add chain on count_ + semaphore signal/wait); verified clean by
# Thread Sanitizer on the same tests.

# moodycamel::LightweightSemaphore internals (spin counter + sem_t fallback).
{
   moodycamel_lightweight_semaphore
   Helgrind:Race
   ...
   fun:*moodycamel*LightweightSemaphore*
}

# --- Definite leaks in third-party init paths -------------------------------
# The entries above only match possible/reachable kinds. Memcheck is run with
# --errors-for-leak-kinds=definite, so these two are the only entries in this
# file that can affect pass/fail. Together they account for all 23 definite
# records seen on the quick test set (22 readline + 1 loader), and neither can
# mask a leak in src/ale: the suppressed blocks are allocated inside readline
# and inside glibc's loader, never by ALE code.

# CPython's readline extension (libreadline/libedit) allocates its completer,
# history state and terminal name strings at module init and never frees them;
# the module lives for the interpreter's lifetime. 22 definite records.
{
   python_readline_module_init
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible
   ...
   fun:PyInit_readline
   ...
}

# glibc's dlopen keeps the dependency-map scratch allocation for the lifetime
# of the loaded object; reported as definite once per interpreter. Observed
# under CPython's extension-module import, but the trailing '...' also matches
# ALE's own dlopen (common/DynamicLoad.cpp, used when SDL_DYNLOAD=ON). That is
# still safe to suppress: the block is malloc'd inside _dl_map_object_deps, so
# it belongs to the loader regardless of which caller triggered the dlopen.
{
   glibc_dlopen_map_object_deps
   Memcheck:Leak
   match-leak-kinds: definite,indirect
   ...
   fun:_dl_map_object_deps
   ...
}
